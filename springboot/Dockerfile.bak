# 第一阶段：使用 Maven 镜像构建项目
FROM maven:3.9.9-eclipse-temurin-21 AS build
WORKDIR /app
# 先复制 pom.xml 并下载依赖（利用 Docker 缓存，加速构建）
COPY springboot/pom.xml .
RUN mvn dependency:go-offline -B
# 复制源代码并打包
COPY springboot/src ./src
RUN mvn clean package -DskipTests

# 第二阶段：使用精简的 JRE 镜像运行项目
FROM eclipse-temurin:21-jre-alpine
WORKDIR /app
# 从构建阶段复制生成的 jar 包
COPY --from=build /app/target/*.jar app.jar
# 暴露端口（Railway 会通过 PORT 环境变量覆盖）
EXPOSE 8080
# 启动应用
ENTRYPOINT ["java", "-jar", "-Dserver.port=${PORT:-8080}", "app.jar"]